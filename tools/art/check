#!/usr/bin/env bash
# Run the automatic checks on the art exports. Exit code 0 = all passed.
#
# Environment:
#   ASEPRITE  path to the Aseprite executable (default: `aseprite` on PATH)
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../.." && pwd)"
aseprite="${ASEPRITE:-aseprite}"

native() {
  if command -v cygpath >/dev/null 2>&1; then cygpath -w "$1"; else printf '%s' "$1"; fi
}

"$aseprite" -b --script-param "root=$(native "$root")" --script "$(native "$here/check.lua")"
